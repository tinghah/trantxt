FROM node:18-alpine as builder

WORKDIR /app/backend

# Copy package files
COPY backend/package*.json ./

# Install dependencies (skip postinstall scripts to avoid sharp/canvas build issues in builder)
RUN npm ci --ignore-scripts

# Copy source code
COPY backend/src ./src
COPY backend/tsconfig.json ./

# Build TypeScript
RUN npm run build

# Production stage
FROM node:18-alpine

WORKDIR /app/backend

# Install dumb-init, build deps, and Unicode fonts for PDF export
RUN apk add --no-cache dumb-init python3 make g++ vips-dev font-noto font-noto-cjk font-noto-myanmar

# Copy package files
COPY backend/package*.json ./

# Install production dependencies only
# Skip postinstall scripts to avoid sharp download issues, then rebuild sharp with system vips
RUN npm ci --only=production --ignore-scripts && npm rebuild sharp

# Copy built files from builder
COPY --from=builder /app/backend/dist ./dist

# Create upload directory and set ownership
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    mkdir -p /app/uploads && \
    chown -R nodejs:nodejs /app/uploads

USER nodejs

EXPOSE 3001

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

CMD ["node", "dist/index.js"]
